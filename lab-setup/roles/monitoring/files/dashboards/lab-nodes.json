{
  "uid": "lab-nodes",
  "title": "03 \u2014 All eight hosts",
  "description": "Host-level CPU, memory, PSI, storage, network and clock pressure.",
  "tags": [
    "research",
    "lab"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "timezone": "utc",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU busy",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100*(1-avg by(instance)(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])))",
          "legendFormat": "__auto",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory available",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemAvailable_bytes",
          "legendFormat": "__auto",
          "range": true
