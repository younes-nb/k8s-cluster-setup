{
  "uid": "lab-databases",
  "title": "09 \u2014 Databases and runtimes",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "research-lab"
  ],
  "timezone": "utc",
  "panels": [
    {
      "id": 1,
      "title": "MySQL running threads",
      "description": "Verify actual exported names and label values against pinned runtime and exporter versions; missing is not zero.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mysql_global_status_threads_running",
          "legendFormat": "{{service_name}} {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "lab-mimir"
          },
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "MySQL exporter health",
      "description": "Verify actual exported names and label values against pinned runtime and exporter versions; missing is not zero.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mysql_up",
          "legendFormat": "{{service_name}} {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "lab-mimir"
          },
          "range": true
        }
      ]
    },
