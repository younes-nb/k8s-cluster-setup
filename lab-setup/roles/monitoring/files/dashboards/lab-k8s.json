      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(20, sum by(pod)(rate(container_cpu_usage_seconds_total{namespace=\"train-ticket\",container!=\"\",container!=\"POD\"}[1m])))",
          "legendFormat": "{{pod}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "custom": {
            "drawStyle": "line",
