{
  "uid": "lab-logs",
  "title": "07 | Benchmark errors and Kubernetes events",
  "description": "Loki log views. Missing labels mean the collector has not seen them yet.",
  "tags": [
    "research",
    "lab"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "timezone": "utc",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "Application errors",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "lab-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=\"train-ticket\"} |~ \"(?i)exception|error|timeout|outofmemory|rejected\"",
          "legendFormat": "",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 2,
      "type": "logs",
      "title": "All benchmark logs",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "lab-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=\"train-ticket\"}",
          "legendFormat": "",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Monitoring collector logs",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "lab-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=\"monitoring\"}",
          "legendFormat": "",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ],
  "links": [
    {
      "type": "dashboards",
      "title": "Research Lab",
      "tags": [
        "lab"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ]
}
