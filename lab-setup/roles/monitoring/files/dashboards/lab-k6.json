{
  "uid": "lab-k6",
  "title": "02 \u2014 Load generator",
  "description": "k6 remote write. Trends are local summaries, not aggregatable quantiles.",
  "tags": [
    "research",
    "lab"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "timezone": "utc",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Observed HTTP requests/s",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(k6_http_reqs_total[1m]))",
          "legendFormat": "__auto",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP failure fraction",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "k6_http_req_failed_rate",
          "legendFormat": "__auto",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency p90/p95/p99",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.9,sum by(experiment)(rate(k6_http_req_duration[1m])))",
          "legendFormat": "P90 {{experiment}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95,sum by(experiment)(rate(k6_http_req_duration[1m])))",
          "legendFormat": "P95 {{experiment}}",
          "range": true
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99,sum by(experiment)(rate(k6_http_req_duration[1m])))",
          "legendFormat": "P99 {{experiment}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Active and allocated VUs",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "k6_vus",
          "legendFormat": "active",
          "range": true
        },
        {
          "refId": "B",
          "expr": "k6_vus_max",
          "legendFormat": "max",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Dropped iterations/s",
      "description": "Not attempted requests.",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(k6_dropped_iterations_total[1m]))",
          "legendFormat": "__auto",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Explicit outcome counters",
      "description": "The timeout counter is a subset of failures. Smoke metrics are not business outcomes.",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(k6_lab_attempted_total[1m]))",
          "legendFormat": "attempted",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(rate(k6_lab_good_total[1m]))",
          "legendFormat": "good",
          "range": true
        },
        {
          "refId": "C",
          "expr": "sum(rate(k6_lab_failed_total[1m]))",
          "legendFormat": "failed",
          "range": true
        },
        {
          "refId": "D",
          "expr": "sum(rate(k6_lab_slow_success_total[1m]))",
          "legendFormat": "slow",
          "range": true
        },
        {
          "refId": "E",
          "expr": "sum(rate(k6_lab_timeout_total[1m]))",
          "legendFormat": "timeouts",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Loadgen CPU",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100*(1-avg(rate(node_cpu_seconds_total{instance=\"loadgen\",mode=\"idle\"}[1m])))",
          "legendFormat": "__auto",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Loadgen network",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(node_network_receive_bytes_total{instance=\"loadgen\",device!=\"lo\"}[1m]))",
          "legendFormat": "RX",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(rate(node_network_transmit_bytes_total{instance=\"loadgen\",device!=\"lo\"}[1m]))",
          "legendFormat": "TX",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ],
  "links": [
    {
      "type": "dashboards",
      "title": "Research Lab",
      "tags": [
        "lab"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ]
}

