# Mimir (single binary, filesystem storage). Mirrors the in-cluster mimir-conf
# ConfigMap so the metrics, labels and retention semantics are unchanged.
multitenancy_enabled: false

server:
  http_listen_port: 8080
  grpc_listen_port: 9095

distributor: {}
ingester_client: {}

ingester:
  ring:
    kvstore:
      store: inmemory
    replication_factor: 1

blocks_storage:
  backend: filesystem
  bucket_store:
    sync_dir: /mimir/sync
  filesystem:
    dir: /mimir/blocks
  tsdb:
    dir: /mimir/tsdb

compactor:
  data_dir: /mimir/compactor
  sharding_ring:
    kvstore:
      store: inmemory

store_gateway:
  sharding_ring:
    replication_factor: 1

limits:
  compactor_blocks_retention_period: {{ monitoring_retention }}
  max_label_names_per_series: 50
  ingestion_rate: 500000
  ingestion_burst_size: 2000000
  max_global_series_per_user: 4000000