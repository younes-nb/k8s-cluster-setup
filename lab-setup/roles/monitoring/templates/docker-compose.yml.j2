# Monitoring stack, hosted on the `monitoring` host (NOT in the cluster).
#
# Ports match the old in-cluster Service ports so 127.0.0.1:18080 (Mimir) and
# 127.0.0.1:3100 (Loki) keep working for every existing script, and the
# in-cluster Alloy scraper pushes to <monitoring_host>:<port> over the private
# network. Published only on the private address and loopback where needed.
services:
  mimir:
    image: {{ monitoring_mimir_image }}
    command: ["-config.file=/etc/mimir/mimir.yaml", "-target=all"]
    container_name: mimir
    ports:
      - "{{ monitoring_host }}:{{ monitoring_ports.mimir }}:8080"
      - "127.0.0.1:{{ monitoring_ports.mimir }}:8080"
    volumes:
      - ./conf/mimir.yaml:/etc/mimir/mimir.yaml:ro
      - ./conf/rules:/etc/mimir/rules:ro
      - {{ monitoring_data_dir }}/mimir:/mimir
    restart: unless-stopped
    # 8g was too small: during high-churn runs the ingester holds millions
    # of active istio series and thrashes (pushes time out, the ring marks
    # the ingester unhealthy). mon1 has 251 GiB, so give it room.
    mem_limit: 48g

  loki:
    image: {{ monitoring_loki_image }}
    command: ["-config.file=/etc/loki/loki.yaml"]
    container_name: loki
    ports:
      - "{{ monitoring_host }}:{{ monitoring_ports.loki }}:3100"
      - "127.0.0.1:{{ monitoring_ports.loki }}:3100"
    volumes:
      - ./conf/loki.yaml:/etc/loki/loki.yaml:ro
      - {{ monitoring_data_dir }}/loki:/loki
    restart: unless-stopped
    mem_limit: 4g

  tempo:
    image: {{ monitoring_tempo_image }}
    command: ["-config.file=/etc/tempo/tempo.yaml"]
    container_name: tempo
    ports:
      - "{{ monitoring_host }}:{{ monitoring_ports.tempo }}:3200"
      - "127.0.0.1:{{ monitoring_ports.tempo }}:3200"
      # OTLP gRPC/HTTP must be reachable from inside the cluster (Alloy pushes
      # traces here). Without these, Tempo accepts nothing and the traces pile
      # up in the retired in-cluster Tempo instead (2026-11-19).
    volumes:
      - ./conf/tempo.yaml:/etc/tempo/tempo.yaml:ro
      - {{ monitoring_data_dir }}/tempo:/var/tempo
    restart: unless-stopped
    mem_limit: 2g

  grafana:
    image: {{ monitoring_grafana_image }}
    container_name: grafana
    user: "472:472"
    ports:
      - "{{ monitoring_host }}:{{ monitoring_ports.grafana }}:3000"
      - "127.0.0.1:{{ monitoring_ports.grafana }}:3000"
    environment:
      GF_METRICS_ENABLED: "true"
      GF_SECURITY_ADMIN_PASSWORD: "${GRAFANA_ADMIN_PASSWORD:?set Grafana admin password in protected .env}"
      GF_AUTH_ANONYMOUS_ENABLED: "false"
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_AUTH_DISABLE_LOGIN_FORM: "false"
    volumes:
      - {{ monitoring_data_dir }}/grafana:/var/lib/grafana
      - ./conf/grafana/provisioning:/etc/grafana/provisioning:ro
    restart: unless-stopped
    mem_limit: 1g
  alloy-gateway:
    image: {{ alloy_image }}
    command: [run, '--server.http.listen-addr=0.0.0.0:12345', '--storage.path=/var/lib/alloy', /etc/alloy/config.alloy]
    ports:
      - "{{ monitoring_host }}:4317:4317"
      - "{{ monitoring_host }}:4318:4318"
    volumes:
      - ./conf/alloy-gateway.alloy:/etc/alloy/config.alloy:ro
      - {{ monitoring_data_dir }}/alloy:/var/lib/alloy
    restart: unless-stopped
    mem_limit: 8g

  pyroscope:
    image: {{ monitoring_pyroscope_image }}
    user: "0:0"
    command: ['-storage.backend=filesystem', '-storage.filesystem.dir=/data/blocks', '-pyroscopedb.data-path=/data/db', '-pyroscopedb.retention-policy-min-disk-available-percentage=0.15', '-compactor.blocks-retention-period={{ monitoring_profile_retention }}']
    ports:
      - "{{ monitoring_host }}:4040:4040"
    volumes:
      - {{ monitoring_data_dir }}/pyroscope:/data
    restart: unless-stopped
    mem_limit: 4g

