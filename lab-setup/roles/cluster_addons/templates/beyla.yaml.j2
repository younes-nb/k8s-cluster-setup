---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: beyla
  namespace: {{ monitoring_ns }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: beyla
rules:
  - apiGroups: [""]
    resources: [nodes, pods, namespaces, services]
    verbs: [get, list, watch]
  - apiGroups: ["apps"]
    resources: [deployments, daemonsets, replicasets]
    verbs: [get, list, watch]
  - apiGroups: ["extensions"]
    resources: [daemonsets]
    verbs: [get, list, watch]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: beyla
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: beyla
subjects:
  - kind: ServiceAccount
    name: beyla
    namespace: {{ monitoring_ns }}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: beyla-conf
  namespace: {{ monitoring_ns }}
data:
  beyla-config.yml: |
    routes:
      unmatched: heuristic
    discovery:
      instrument:
        # instrument only the Train-Ticket application services; the
        # monitoring/kube-system/cert-manager namespaces are already in
        # Beyla's default exclusion list, and services exporting their own
        # OTel telemetry (e.g. Istio) are auto-skipped by
        # exclude_otel_instrumented_services (default true).
        - k8s_namespace: train-ticket

---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: beyla
  namespace: {{ monitoring_ns }}
  labels:
    app: beyla
spec:
  selector:
    matchLabels:
      app: beyla
  template:
    metadata:
      labels:
        app: beyla
    spec:
      serviceAccountName: beyla
      hostNetwork: true
      hostPID: true
      # hostNetwork pods must use ClusterFirstWithHostNet for cluster DNS
      # (plain ClusterFirst is ignored for host-network pods, so
      # *.monitoring.svc.cluster.local names would fail to resolve and the
      # OTLP exporter to Alloy errors with "produced zero addresses").
      dnsPolicy: ClusterFirstWithHostNet
      containers:
      - name: beyla
        image: {{ beyla_image }}
        env:
          - name: BEYLA_SERVICE_NAMESPACE
            value: "train-ticket"
          - name: BEYLA_TRACE_PRINTER
            value: "text"
          - name: BEYLA_LOG_LEVEL
            value: "info"
          - name: BEYLA_INTERNAL_METRICS_PROMETHEUS_PORT
            value: "8080"
          - name: BEYLA_KUBE_METADATA_ENABLE
            value: "true"
          # Beyla 3.x REQUIRES a discovery section (or network metrics config)
          # to start; the legacy BEYLA_OPEN_PORT env used to stand in for that
          # existence check, but as a selector open_ports "0" matches nothing
          # (no process listens on port 0), so nothing was ever instrumented.
          # The real selection now lives in beyla-config.yml (mounted below).
          - name: BEYLA_CONFIG_PATH
            value: "/config/beyla-config.yml"
          - name: OTEL_EXPORTER_OTLP_ENDPOINT
            value: "http://alloy.{{ monitoring_ns }}.svc.cluster.local:4317"
        ports:
        - {containerPort: 8080, name: metrics}
        volumeMounts:
        - {name: conf, mountPath: /config}
        - {name: debugfs, mountPath: /sys/kernel/debug, readOnly: true}
        - {name: tracefs, mountPath: /sys/kernel/tracing, readOnly: true}
        securityContext:
          privileged: true
          capabilities:
            add: [SYS_ADMIN, SYS_RESOURCE, CAP_DAC_OVERRIDE, CAP_SYS_PTRACE, CAP_BPF]
        resources:
          requests: {cpu: "100m", memory: "256Mi"}
          limits: {cpu: "2000m", memory: "1Gi"}
        readinessProbe:
          tcpSocket:
            port: 8080
          initialDelaySeconds: 15
          periodSeconds: 10
      volumes:
      - name: conf
        configMap:
          name: beyla-conf
      - name: debugfs
        hostPath:
          path: /sys/kernel/debug
      - name: tracefs
        hostPath:
          path: /sys/kernel/tracing
      tolerations:
      - operator: Exists
        effect: NoSchedule
      - operator: Exists
        effect: NoExecute
---
apiVersion: v1
kind: Service
metadata:
  name: beyla
  namespace: {{ monitoring_ns }}
spec:
  selector:
    app: beyla
  ports:
  - {name: metrics, port: 8080, targetPort: 8080}

