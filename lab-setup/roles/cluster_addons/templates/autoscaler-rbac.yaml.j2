apiVersion: v1
kind: Namespace
metadata: {name: autoscaling-research}
---
apiVersion: v1
kind: ServiceAccount
metadata: {name: replica-controller, namespace: autoscaling-research}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata: {name: benchmark-replica-controller, namespace: {{ tt_ns }}}
rules:
  - apiGroups: [apps]
    resources: [deployments, replicasets]
    verbs: [get, list, watch]
  - apiGroups: [apps]
    resources: [deployments/scale]
    verbs: [get, update, patch]
  - apiGroups: ['']
    resources: [pods, services, events, resourcequotas]
    verbs: [get, list, watch]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata: {name: benchmark-replica-controller, namespace: {{ tt_ns }}}
roleRef: {apiGroup: rbac.authorization.k8s.io, kind: Role, name: benchmark-replica-controller}
subjects:
  - {kind: ServiceAccount, name: replica-controller, namespace: autoscaling-research}

