---
apiVersion: v1
kind: ConfigMap
metadata:
  name: tempo-conf
  namespace: {{ monitoring_ns }}
data:
  tempo.yaml: |
    stream_over_http_enabled: true
    server:
      http_listen_port: 3200
      grpc_listen_port: 9095
    distributor:
      receivers:
        otlp:
          protocols:
            grpc:
              endpoint: 0.0.0.0:4317
            http:
              endpoint: 0.0.0.0:4318
    query_frontend:
      mcp_server:
        enabled: false
    storage:
      trace:
        backend: local
        wal:
          path: /var/tempo/wal
        local:
          path: /var/tempo/blocks
    backend_worker:
      compaction:
        block_retention: {{ tempo_retention }}
    overrides:
      defaults:
        metrics_generator:
          processors: ["span-metrics", "service-graphs"]
          generate_native_histograms: both
    usage_report:
      reporting_enabled: false
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: tempo
  namespace: {{ monitoring_ns }}
  labels:
    app: tempo
spec:
  replicas: 1
  selector:
    matchLabels:
      app: tempo
  template:
    metadata:
      labels:
        app: tempo
    spec:
      containers:
      - name: tempo
        image: {{ tempo_image }}
        args: ["-config.file=/conf/tempo.yaml"]
        ports:
        - {containerPort: 3200, name: http}
        - {containerPort: 9095, name: grpc}
        - {containerPort: 4317, name: otlp-grpc}
        - {containerPort: 4318, name: otlp-http}
        volumeMounts:
        - {name: conf, mountPath: /conf}
        - {name: data, mountPath: /var/tempo}
        resources:
          requests: {cpu: "200m", memory: "512Mi"}
          limits: {cpu: "1000m", memory: "2Gi"}
      volumes:
      - name: conf
        configMap:
          name: tempo-conf
      - name: data
        persistentVolumeClaim:
          claimName: tempo-data
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: tempo-data
  namespace: {{ monitoring_ns }}
spec:
  accessModes: ["ReadWriteOnce"]
  storageClassName: {{ storage_class }}
  resources:
    requests:
      storage: {{ tempo_pvc_size }}
---
apiVersion: v1
kind: Service
metadata:
  name: tempo
  namespace: {{ monitoring_ns }}
spec:
  selector:
    app: tempo
  ports:
  - {name: http, port: 3200, targetPort: 3200}
  - {name: grpc-otlp, port: 4317, targetPort: 4317}
  - {name: http-otlp, port: 4318, targetPort: 4318}
