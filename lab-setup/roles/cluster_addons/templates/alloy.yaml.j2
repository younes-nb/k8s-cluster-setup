---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: alloy
  namespace: {{ monitoring_ns }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: alloy-scrape
rules:
  - apiGroups: [""]
    resources: [nodes, nodes/metrics, nodes/proxy, services, endpoints, pods, pods/log]
    verbs: [get, list, watch]
  - apiGroups: [discovery.k8s.io]
    resources: [endpointslices]
    verbs: [get, list, watch]
  - apiGroups: [monitoring.coreos.com]
    resources: [servicemonitors, podmonitors, probes, scrapeconfigs]
    verbs: [get, list, watch]
  - apiGroups: [networking.k8s.io]
    resources: [ingresses]
    verbs: [get, list, watch]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: alloy-scrape
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: alloy-scrape
subjects:
  - kind: ServiceAccount
    name: alloy
    namespace: {{ monitoring_ns }}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: alloy-conf
  namespace: {{ monitoring_ns }}
data:
  config.alloy: |
    prometheus.operator.servicemonitors "all" {
      forward_to = [prometheus.remote_write.mimir.receiver]
    }
    prometheus.operator.podmonitors "all" {
      forward_to = [prometheus.remote_write.mimir.receiver]
    }
    prometheus.operator.probes "all" {
      forward_to = [prometheus.remote_write.mimir.receiver]
    }

    prometheus.scrape "kubelet" {
      targets = [
        {% for node in groups['nodes'] | difference(['loadgen']) %}
        {"__address__" = "kubernetes.default.svc:443", "__metrics_path__" = "/api/v1/nodes/{{ node }}/proxy/metrics/cadvisor", "node" = "{{ node }}"},
        {% endfor %}
      ]
      forward_to = [prometheus.remote_write.mimir.receiver]
      scrape_interval = "{{ alloy_scrape_interval }}"
      scrape_timeout = "{{ alloy_scrape_interval }}"
      scheme = "https"
      bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
      tls_config {
        ca_file = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
      }
    }

    // NOTE: no explicit kube-state-metrics scrape here. The kube-prometheus-stack
    // chart ships a ServiceMonitor for KSM which
    // `prometheus.operator.servicemonitors "all"` already picks up (job =
    // "kube-state-metrics"). The hand-written `prometheus.scrape "ksm"` block
    // that used to live here scraped the SAME target a second time (job =
    // "prometheus.scrape.ksm"), so every kube_* series existed twice and naive
    // `sum()` queries double-counted — e.g. cluster CPU capacity read 480 cores
    // instead of 240 (2026-11-19). Delete one of the two; keep the ServiceMonitor.

    prometheus.exporter.unix "node_exporter" {
      rootfs_path = "/host"
      procfs_path = "/host/proc"
      sysfs_path = "/host/sys"
      set_collectors = ["cpu", "meminfo", "filesystem", "loadavg", "netdev", "netstat", "diskstats", "vmstat", "stat", "time", "timex", "uname", "boottime", "entropy", "filefd", "interrupts", "ipvs", "ksmd", "mountstats", "nfs", "nfsd", "os", "pressure", "rapl", "schedstat", "sockstat", "softnet", "thermal_zone", "xfs", "zfs", "zoneinfo", "btrfs", "buddyinfo", "conntrack", "dmi", "edac", "fibrechannel", "hwmon", "infiniband", "mdadm", "nvme", "powersupplyclass", "udp_queues"]
    }

    prometheus.scrape "node_exporter" {
      targets = prometheus.exporter.unix.node_exporter.targets
      forward_to = [prometheus.remote_write.mimir.receiver]
      scrape_interval = "{{ alloy_scrape_interval }}"
      scrape_timeout = "{{ alloy_scrape_interval }}"
    }

    prometheus.remote_write "mimir" {
      endpoint {
        // Monitoring is no longer in the cluster: Mimir runs on the monitoring
        // host (currently 10.10.1.1, the loadgen's private address). Alloy stays
        // in the cluster because pod IPs are not routable from outside.
        url = "http://{{ monitoring_host }}:{{ monitoring_mimir_port }}/api/v1/push"
      }
    }

    // OTLP -> Prometheus bridge: Beyla exports RED metrics over OTLP gRPC;
    // Alloy's receiver only serves the signals that have consumers, so an
    // empty metrics output makes OTLP metrics fail with
    // "Unimplemented: unknown service ...MetricsService". Convert and push
    // them into the same remote_write path as the scraped metrics.
    otelcol.exporter.prometheus "beyla" {
      forward_to = [prometheus.remote_write.mimir.receiver]
    }

    discovery.kubernetes "pods" {
      role = "pod"
    }
    loki.source.kubernetes "pods" {
      targets = discovery.kubernetes.pods.targets
      forward_to = [loki.write.loki.receiver]
    }
    loki.write "loki" {
      endpoint {
        // Loki also runs on the monitoring host now (see the Mimir note above).
        url = "http://{{ monitoring_host }}:{{ monitoring_loki_port }}/loki/api/v1/push"
      }
    }

    otelcol.receiver.otlp "in" {
      grpc {
        endpoint = "0.0.0.0:4317"
      }
      http {
        endpoint = "0.0.0.0:4318"
      }
      output {
        metrics = [otelcol.exporter.prometheus.beyla.input]
        logs = []
        traces = [otelcol.processor.batch.out.input]
      }
    }
    otelcol.processor.batch "out" {
      output {
        metrics = []
        logs = []
        traces = [otelcol.exporter.otlp.tempo.input]
      }
    }
    otelcol.exporter.otlp "tempo" {
      client {
        endpoint = "{{ monitoring_host }}:4317"
        tls {
          insecure = true
          insecure_skip_verify = true
        }
      }
    }
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: alloy
  namespace: {{ monitoring_ns }}
  labels:
    app: alloy
spec:
  replicas: 1
  selector:
    matchLabels:
      app: alloy
  template:
    metadata:
      labels:
        app: alloy
    spec:
      serviceAccountName: alloy
      # Pin Alloy to a control-plane node. Nothing constrained it before, so the
      # scheduler put it on a benchmark worker (worker1, later worker2), where it
      # competed with the load-test pods for CPU/memory. Pod IPs (10.233.0.0/16)
      # are routable from every node, so a master can scrape all kubelets.
      nodeSelector:
        node-role.kubernetes.io/control-plane: ""
      containers:
      - name: alloy
        image: {{ alloy_image }}
        args:
          - run
          - --server.http.listen-addr=0.0.0.0:12345
          - --storage.path=/var/lib/alloy/data
          - /etc/alloy/config.alloy
        ports:
        - {containerPort: 12345, name: http}
        - {containerPort: 4317, name: otlp-grpc}
        - {containerPort: 4318, name: otlp-http}
        volumeMounts:
        - {name: conf, mountPath: /etc/alloy}
        - {name: proc, mountPath: /host/proc, readOnly: true}
        - {name: sys, mountPath: /host/sys, readOnly: true}
        - {name: host-root, mountPath: /host, readOnly: true}
        # Persist the WAL / positions file. Without this the pod's
        # /var/lib/alloy/data lives in the container filesystem, so EVERY Alloy
        # restart replays every pod's log from the beginning (2026-11-19: a
        # restart cost ~3 h of "entry too far behind" rejections and a gap in
        # Loki while it caught up).
        - {name: data, mountPath: /var/lib/alloy/data}
        resources:
          requests: {cpu: "200m", memory: "2Gi"}
          limits: {cpu: "2000m", memory: "8Gi"}  # twice OOMKilled mid-PBScaler-run: 855 tt pods (paper scale-outs) double the per-pod stream/scrape load; 4Gi also OOMKilled at 07:37Z
        readinessProbe:
          httpGet: {path: /-/ready, port: 12345}
          initialDelaySeconds: 20
          periodSeconds: 10
      volumes:
      - name: conf
        configMap:
          name: alloy-conf
      - name: proc
        hostPath:
          path: /proc
      - name: sys
        hostPath:
          path: /sys
      - name: host-root
        hostPath:
          path: /
      # Alloy's own state (WAL + positions). Small and node-local: Alloy is a
      # Deployment, so if it moves nodes the positions file goes with it and the
      # new pod replays from the beginning — acceptable, but the common case
      # (restart on the same node) no longer loses hours of log position.
      - name: data
        persistentVolumeClaim:
          claimName: alloy-data
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: alloy-data
  namespace: {{ monitoring_ns }}
spec:
  accessModes: ["ReadWriteOnce"]
  storageClassName: {{ storage_class }}
  resources:
    requests:
      storage: 5Gi
---
apiVersion: v1
kind: Service
metadata:
  name: alloy
  namespace: {{ monitoring_ns }}
spec:
  selector:
    app: alloy
  ports:
  - {name: http, port: 12345, targetPort: 12345}
  # OTLP ingestion (all traffic opts) — Beyla exports here; kube-proxy only
  # NATs listed service ports, so OTLP must be declared on the Service even
  # though the Alloy container already listens on 0.0.0.0:4317/4318.
  - {name: otlp-grpc, port: 4317, targetPort: 4317}
  - {name: otlp-http, port: 4318, targetPort: 4318}
