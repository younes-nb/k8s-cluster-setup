---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: alloy
  namespace: {{ monitoring_ns }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: alloy-scrape
rules:
  - apiGroups: [""]
    resources: [nodes, nodes/metrics, services, endpoints, pods, events]
    verbs: [get, list, watch]
  - nonResourceURLs: ["/metrics"]
    verbs: [get]
  - apiGroups: [events.k8s.io]
    resources: [events]
    verbs: [get, list, watch]
  - apiGroups: [discovery.k8s.io]
    resources: [endpointslices]
    verbs: [get, list, watch]
  - apiGroups: [monitoring.coreos.com]
    resources: [servicemonitors, podmonitors, probes, scrapeconfigs]
    verbs: [get, list, watch]
  - apiGroups: [networking.k8s.io]
    resources: [ingresses]
    verbs: [get, list, watch]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: alloy-scrape
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: alloy-scrape
subjects:
  - kind: ServiceAccount
    name: alloy
    namespace: {{ monitoring_ns }}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: alloy-conf
  namespace: {{ monitoring_ns }}
data:
  config.alloy: |
    prometheus.operator.servicemonitors "all" {
      // The kube-prometheus-stack ServiceMonitors (apiserver, coredns, ...) use
      // local CA files; Alloy rejects those unless this is true. podmonitors does
      // not support the attribute, so it is set only here.
      allow_arbitrary_file_access = true
      // ServiceMonitors set interval 5s but no timeout; Alloy's default 10s
      // timeout would exceed the interval and the whole ServiceMonitor is dropped
      // ("scrape timeout greater than scrape interval").
      scrape {
        default_scrape_interval = "5s"
        default_scrape_timeout  = "4s"
      }
      forward_to = [prometheus.remote_write.mimir.receiver]
    }
    prometheus.operator.podmonitors "all" {
      forward_to = [prometheus.remote_write.mimir.receiver]
    }

    prometheus.scrape "kubelet" {
      targets = [
        {% for node in groups['control_plane'] + groups['workers'] %}
        {"__address__" = "{{ cloudlab_private_ips[node] }}:10250", "__metrics_path__" = "/metrics/cadvisor", "node" = "{{ node }}"},
        {% endfor %}
      ]
      forward_to = [prometheus.remote_write.mimir.receiver]
      scrape_interval = "{{ alloy_scrape_interval }}"
      scrape_timeout = "{{ alloy_scrape_timeout }}"
      scheme = "https"
      bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
      tls_config {
        ca_file = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
      }
    }

    // NOTE: no explicit kube-state-metrics scrape here. The kube-prometheus-stack
    // chart ships a ServiceMonitor for KSM which
    // `prometheus.operator.servicemonitors "all"` already picks up (job =
    // "kube-state-metrics"). The hand-written `prometheus.scrape "ksm"` block
    // that used to live here scraped the SAME target a second time (job =
    // "prometheus.scrape.ksm"), so every kube_* series existed twice and naive
    // `sum()` queries double-counted — e.g. cluster CPU capacity read 480 cores
    // instead of 240 (2026-11-19). Delete one of the two; keep the ServiceMonitor.

    // Scrape each infrastructure Pod, never a load-balanced Service address.
    discovery.kubernetes "benchmark_infra" {
      role = "pod"
      namespaces {
        names = ["{{ tt_ns }}"]
      }
    }
    {% for app, port, path in [('nacos','client','/nacos/actuator/prometheus'), ('rabbitmq','prometheus','/metrics')] %}
    discovery.relabel "{{ app }}_metrics" {
      targets = discovery.kubernetes.benchmark_infra.targets
      rule {
        source_labels = ["__meta_kubernetes_pod_label_app", "__meta_kubernetes_pod_container_port_name", "__meta_kubernetes_pod_phase"]
        regex = "{{ app }};{{ port }};Running"
        action = "keep"
      }
      rule {
        source_labels = ["__meta_kubernetes_pod_name"]
        target_label = "pod"
      }
      rule {
        source_labels = ["__meta_kubernetes_pod_name"]
        target_label = "instance"
      }
      rule {
        source_labels = ["__meta_kubernetes_namespace"]
        target_label = "namespace"
      }
    }
    prometheus.scrape "{{ app }}_metrics" {
      targets = discovery.relabel.{{ app }}_metrics.output
      job_name = "lab-{{ app }}"
      metrics_path = "{{ path }}"
      scrape_interval = "15s"
      scrape_timeout = "4s"
      forward_to = [prometheus.remote_write.mimir.receiver]
    }
    {% endfor %}

    prometheus.exporter.self "cluster" {}
    prometheus.scrape "self" {
      targets = prometheus.exporter.self.cluster.targets
      scrape_interval = "15s"
      job_name = "alloy-cluster"
      forward_to = [prometheus.remote_write.mimir.receiver]
    }
    prometheus.remote_write "mimir" {
      endpoint {
        url = "http://{{ monitoring_host }}:{{ monitoring_mimir_port }}/api/v1/push"
      }
    }
    loki.source.kubernetes_events "events" {
      forward_to = [loki.write.remote.receiver]
    }
    loki.write "remote" {
      endpoint {
        url = "http://{{ monitoring_host }}:{{ monitoring_loki_port }}/loki/api/v1/push"
      }
    }

    {% for name in tt_mongodb_exporters.keys() %}
    prometheus.exporter.mongodb "{{ name | replace('-', '_') }}" {
      mongodb_uri = sys.env("MONGO_{{ loop.index }}")
    }
    discovery.relabel "mongo_{{ loop.index }}" {
      targets = prometheus.exporter.mongodb.{{ name | replace('-', '_') }}.targets
      rule {
        target_label = "instance"
        replacement = "{{ name }}"
      }
    }
    prometheus.scrape "mongo_{{ loop.index }}" {
      targets = discovery.relabel.mongo_{{ loop.index }}.output
      scrape_interval = "15s"
      job_name = "lab-mongodb"
      forward_to = [prometheus.remote_write.mimir.receiver]
    }
    {% endfor %}
    {% for name in tt_mysql_exporters.keys() %}
    prometheus.exporter.mysql "{{ name | replace('-', '_') }}" {
      data_source_name = sys.env("MYSQL_{{ loop.index }}")
    }
    discovery.relabel "mysql_{{ loop.index }}" {
      targets = prometheus.exporter.mysql.{{ name | replace('-', '_') }}.targets
      rule {
        target_label = "instance"
        replacement = "{{ name }}"
      }
      rule {
        target_label = "job"
        replacement = "lab-mysql"
      }
    }
    prometheus.scrape "mysql_{{ loop.index }}" {
      targets = discovery.relabel.mysql_{{ loop.index }}.output
      scrape_interval = "15s"
      job_name = "lab-mysql"
      forward_to = [prometheus.remote_write.mimir.receiver]
    }
    {% endfor %}

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: alloy
  namespace: {{ monitoring_ns }}
  labels:
    app: alloy
spec:
  replicas: 1
  strategy: {type: Recreate}
  selector:
    matchLabels:
      app: alloy
  template:
    metadata:
      labels:
        app: alloy
    spec:
      serviceAccountName: alloy
      tolerations:
      - key: node-role.kubernetes.io/control-plane
        operator: Exists
        effect: NoSchedule
      # Pin Alloy to a control-plane node. Nothing constrained it before, so the
      # scheduler put it on a benchmark worker (worker1, later worker2), where it
      # competed with the load-test pods for CPU/memory. Pod IPs (10.233.0.0/16)
      # are routable from every node, so a master can scrape all kubelets.
      nodeSelector:
        node-role.kubernetes.io/control-plane: ""
      containers:
      - name: alloy
        image: {{ alloy_image }}
        envFrom:
          - secretRef: {name: alloy-db-monitoring}
        args:
          - run
          - --server.http.listen-addr=0.0.0.0:12345
          - --storage.path=/var/lib/alloy/data
          - /etc/alloy/config.alloy
        ports:
        - {containerPort: 12345, name: http}
        volumeMounts:
        - {name: conf, mountPath: /etc/alloy}
        # Persist the WAL / positions file. Without this the pod's
        # /var/lib/alloy/data lives in the container filesystem, so EVERY Alloy
        # restart replays every pod's log from the beginning (2026-11-19: a
        # restart cost ~3 h of "entry too far behind" rejections and a gap in
        # Loki while it caught up).
        - {name: data, mountPath: /var/lib/alloy/data}
        resources:
          requests: {cpu: "200m", memory: "2Gi"}
          limits: {cpu: "2000m", memory: "8Gi"}  # twice OOMKilled mid-PBScaler-run: 855 tt pods (paper scale-outs) double the per-pod stream/scrape load; 4Gi also OOMKilled at 07:37Z
        readinessProbe:
          httpGet: {path: /-/ready, port: 12345}
          initialDelaySeconds: 20
          periodSeconds: 10
      volumes:
      - name: conf
        configMap:
          name: alloy-conf
      # Alloy's own state (WAL + positions). Small and node-local: Alloy is a
      # Deployment, so if it moves nodes the positions file goes with it and the
      # new pod replays from the beginning — acceptable, but the common case
      # (restart on the same node) no longer loses hours of log position.
      - name: data
        persistentVolumeClaim:
          claimName: alloy-data
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: alloy-data
  namespace: {{ monitoring_ns }}
spec:
  accessModes: ["ReadWriteOnce"]
  storageClassName: {{ storage_class }}
  resources:
    requests:
      storage: 5Gi
---
apiVersion: v1
kind: Service
metadata:
  name: alloy
  namespace: {{ monitoring_ns }}
spec:
  selector:
    app: alloy
  ports:
  - {name: http, port: 12345, targetPort: 12345}

