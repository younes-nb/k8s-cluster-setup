---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: alloy
  namespace: {{ monitoring_ns }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: alloy-scrape
rules:
  - apiGroups: [""]
    resources: [nodes, nodes/metrics, nodes/proxy, services, endpoints, pods, pods/log]
    verbs: [get, list, watch]
  - apiGroups: [discovery.k8s.io]
    resources: [endpointslices]
    verbs: [get, list, watch]
  - apiGroups: [monitoring.coreos.com]
    resources: [servicemonitors, podmonitors, probes, scrapeconfigs]
    verbs: [get, list, watch]
  - apiGroups: [networking.k8s.io]
    resources: [ingresses]
    verbs: [get, list, watch]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: alloy-scrape
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: alloy-scrape
subjects:
  - kind: ServiceAccount
    name: alloy
    namespace: {{ monitoring_ns }}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: alloy-conf
  namespace: {{ monitoring_ns }}
data:
  config.alloy: |
    prometheus.operator.servicemonitors "all" {
      forward_to = [prometheus.remote_write.mimir.receiver]
    }
    prometheus.operator.podmonitors "all" {
      forward_to = [prometheus.remote_write.mimir.receiver]
    }
    prometheus.operator.probes "all" {
      forward_to = [prometheus.remote_write.mimir.receiver]
    }

    prometheus.scrape "kubelet" {
      targets = [
        {% for node in groups['nodes'] | difference(['lb']) %}
        {"__address__" = "kubernetes.default.svc:443", "__metrics_path__" = "/api/v1/nodes/{{ node }}/proxy/metrics/cadvisor", "node" = "{{ node }}"},
        {% endfor %}
      ]
      forward_to = [prometheus.remote_write.mimir.receiver]
      scrape_interval = "{{ alloy_scrape_interval }}"
      scheme = "https"
      bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
      tls_config {
        ca_file = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
      }
    }

    prometheus.scrape "ksm" {
      targets = [
        {"__address__" = "prometheus-stack-kube-state-metrics.{{ monitoring_ns }}.svc.cluster.local:8080"},
      ]
      forward_to = [prometheus.remote_write.mimir.receiver]
      scrape_interval = "{{ alloy_scrape_interval }}"
    }

    prometheus.exporter.unix "node_exporter" {
      rootfs_path = "/host"
      procfs_path = "/host/proc"
      sysfs_path = "/host/sys"
      set_collectors = ["cpu", "meminfo", "filesystem", "loadavg", "netdev", "netstat", "diskstats", "vmstat", "stat", "time", "timex", "uname", "boottime", "entropy", "filefd", "interrupts", "ipvs", "ksmd", "mountstats", "nfs", "nfsd", "os", "pressure", "rapl", "schedstat", "sockstat", "softnet", "thermal_zone", "xfs", "zfs", "zoneinfo", "btrfs", "buddyinfo", "conntrack", "dmi", "edac", "fibrechannel", "hwmon", "infiniband", "mdadm", "nvme", "powersupplyclass", "udp_queues"]
    }

    prometheus.scrape "node_exporter" {
      targets = prometheus.exporter.unix.node_exporter.targets
      forward_to = [prometheus.remote_write.mimir.receiver]
      scrape_interval = "{{ alloy_scrape_interval }}"
    }

    prometheus.remote_write "mimir" {
      endpoint {
        url = "http://mimir.{{ monitoring_ns }}.svc.cluster.local:8080/api/v1/push"
      }
    }

    discovery.kubernetes "pods" {
      role = "pod"
    }
    loki.source.kubernetes "pods" {
      targets = discovery.kubernetes.pods.targets
      forward_to = [loki.write.loki.receiver]
    }
    loki.write "loki" {
      endpoint {
        url = "http://loki.{{ monitoring_ns }}.svc.cluster.local:3100/loki/api/v1/push"
      }
    }

    otelcol.receiver.otlp "in" {
      grpc {
        endpoint = "0.0.0.0:4317"
      }
      http {
        endpoint = "0.0.0.0:4318"
      }
      output {
        metrics = []
        logs = []
        traces = [otelcol.processor.batch.out.input]
      }
    }
    otelcol.processor.batch "out" {
      output {
        metrics = []
        logs = []
        traces = [otelcol.exporter.otlp.tempo.input]
      }
    }
    otelcol.exporter.otlp "tempo" {
      client {
        endpoint = "tempo.{{ monitoring_ns }}.svc.cluster.local:4317"
        tls {
          insecure = true
          insecure_skip_verify = true
        }
      }
    }
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: alloy
  namespace: {{ monitoring_ns }}
  labels:
    app: alloy
spec:
  replicas: 1
  selector:
    matchLabels:
      app: alloy
  template:
    metadata:
      labels:
        app: alloy
    spec:
      serviceAccountName: alloy
      containers:
      - name: alloy
        image: {{ alloy_image }}
        args:
          - run
          - --server.http.listen-addr=0.0.0.0:12345
          - --storage.path=/var/lib/alloy/data
          - /etc/alloy/config.alloy
        ports:
        - {containerPort: 12345, name: http}
        - {containerPort: 4317, name: otlp-grpc}
        - {containerPort: 4318, name: otlp-http}
        volumeMounts:
        - {name: conf, mountPath: /etc/alloy}
        - {name: proc, mountPath: /host/proc, readOnly: true}
        - {name: sys, mountPath: /host/sys, readOnly: true}
        - {name: host-root, mountPath: /host, readOnly: true}
        resources:
          requests: {cpu: "200m", memory: "512Mi"}
          limits: {cpu: "2000m", memory: "2Gi"}
        readinessProbe:
          httpGet: {path: /-/ready, port: 12345}
          initialDelaySeconds: 20
          periodSeconds: 10
      volumes:
      - name: conf
        configMap:
          name: alloy-conf
      - name: proc
        hostPath:
          path: /proc
      - name: sys
        hostPath:
          path: /sys
      - name: host-root
        hostPath:
          path: /
---
apiVersion: v1
kind: Service
metadata:
  name: alloy
  namespace: {{ monitoring_ns }}
spec:
  selector:
    app: alloy
  ports:
  - {name: http, port: 12345, targetPort: 12345}
