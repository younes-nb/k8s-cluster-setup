apiVersion: v1
kind: ServiceAccount
metadata: {name: alloy-node, namespace: {{ monitoring_ns }}}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata: {name: alloy-node}
rules:
  - apiGroups: ['']
    resources: [pods]
    verbs: [get, list, watch]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata: {name: alloy-node}
roleRef: {apiGroup: rbac.authorization.k8s.io, kind: ClusterRole, name: alloy-node}
subjects:
  - {kind: ServiceAccount, name: alloy-node, namespace: {{ monitoring_ns }}}
---
apiVersion: v1
kind: ConfigMap
metadata: {name: alloy-node, namespace: {{ monitoring_ns }}}
data:
  config.alloy: |
    prometheus.exporter.unix "host" {
      rootfs_path = "/host/root"
      procfs_path = "/host/proc"
      sysfs_path = "/host/sys"
    }
    discovery.relabel "host" {
      targets = prometheus.exporter.unix.host.targets
      rule {
        target_label = "instance"
        replacement = sys.env("NODE_NAME")
      }
      rule {
        target_label = "node"
        replacement = sys.env("NODE_NAME")
      }
    }
    prometheus.scrape "host" {
      targets = discovery.relabel.host.output
      scrape_interval = "5s"
      scrape_timeout = "4s"
      job_name = "lab-node"
      forward_to = [prometheus.remote_write.remote.receiver]
    }
    discovery.relabel "etcd_local" {
      targets = [{"__address__" = "127.0.0.1:2381", "instance" = sys.env("NODE_NAME"), "node" = sys.env("NODE_NAME")}]
      rule {
        source_labels = ["node"]
        regex = "master[123]"
        action = "keep"
      }
    }
    prometheus.scrape "etcd_local" {
      targets = discovery.relabel.etcd_local.output
      job_name = "lab-etcd"
      scrape_interval = "5s"
      scrape_timeout = "4s"
      forward_to = [prometheus.remote_write.remote.receiver]
    }
    prometheus.exporter.self "node" {}
    discovery.relabel "self" {
      targets = prometheus.exporter.self.node.targets
      rule {
        target_label = "instance"
        replacement = sys.env("NODE_NAME")
      }
    }
    prometheus.scrape "self" {
      targets = discovery.relabel.self.output
      scrape_interval = "15s"
      job_name = "alloy-node"
      forward_to = [prometheus.remote_write.remote.receiver]
    }
    prometheus.remote_write "remote" {
      endpoint {
        url = "http://{{ monitoring_host }}:{{ monitoring_mimir_port }}/api/v1/push"
      }
    }
    discovery.kubernetes "local" {
      role = "pod"
      selectors {
        role = "pod"
        field = "spec.nodeName=" + sys.env("NODE_NAME")
      }
    }
    discovery.relabel "logs" {
      targets = discovery.kubernetes.local.targets
      rule {
        source_labels = ["__meta_kubernetes_namespace"]
        target_label = "namespace"
      }
      rule {
        source_labels = ["__meta_kubernetes_pod_name"]
        target_label = "pod"
      }
      rule {
        source_labels = ["__meta_kubernetes_pod_container_name"]
        target_label = "container"
      }
      rule {
        source_labels = ["__meta_kubernetes_pod_uid", "__meta_kubernetes_pod_container_name"]
        separator = "/"
        replacement = "/var/log/pods/*$1/*.log"
        target_label = "__path__"
      }
    }
    local.file_match "pods" {
      path_targets = discovery.relabel.logs.output
    }
    loki.source.file "pods" {
      targets = local.file_match.pods.targets
      forward_to = [loki.process.cri.receiver]
    }
    loki.process "cri" {
      stage.cri {}
      forward_to = [loki.write.remote.receiver]
    }
    loki.write "remote" {
      endpoint {
        url = "http://{{ monitoring_host }}:{{ monitoring_loki_port }}/loki/api/v1/push"
      }
    }
---
apiVersion: apps/v1
kind: DaemonSet
metadata: {name: alloy-node, namespace: {{ monitoring_ns }}}
spec:
  selector: {matchLabels: {app: alloy-node}}
  template:
    metadata: {labels: {app: alloy-node}}
    spec:
      serviceAccountName: alloy-node
      hostPID: true
      hostNetwork: true
      dnsPolicy: ClusterFirstWithHostNet
      tolerations:
        - operator: Exists
      containers:
        - name: alloy
          image: {{ alloy_image }}
          args: [run, '--server.http.listen-addr=127.0.0.1:12346', '--storage.path=/var/lib/alloy', /etc/alloy/config.alloy]
          env:
            - name: NODE_NAME
              valueFrom: {fieldRef: {fieldPath: spec.nodeName}}
          resources:
            requests: {cpu: 100m, memory: 256Mi}
            limits: {memory: 2Gi}
          volumeMounts:
            - {name: conf, mountPath: /etc/alloy, readOnly: true}
            - {name: root, mountPath: /host/root, readOnly: true, mountPropagation: HostToContainer}
            - {name: proc, mountPath: /host/proc, readOnly: true}
            - {name: sys, mountPath: /host/sys, readOnly: true}
            - {name: logs, mountPath: /var/log/pods, readOnly: true}
            - {name: data, mountPath: /var/lib/alloy}
          securityContext: {runAsUser: 0, allowPrivilegeEscalation: false}
      volumes:
        - {name: conf, configMap: {name: alloy-node}}
        - {name: root, hostPath: {path: /}}
        - {name: proc, hostPath: {path: /proc}}
        - {name: sys, hostPath: {path: /sys}}
        - {name: logs, hostPath: {path: /var/log/pods}}
        - {name: data, hostPath: {path: /var/lib/alloy-node, type: DirectoryOrCreate}}

