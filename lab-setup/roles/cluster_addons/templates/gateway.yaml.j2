apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: train-ticket-gateway
  namespace: "{{ tt_ns }}"
spec:
  gatewayClassName: "{{ gateway_class }}"
  listeners:
  - name: http
    protocol: HTTP
    port: 80
{% if tt_host is defined and tt_host %}
  - name: https
    protocol: HTTPS
    port: 443
    tls:
      mode: Terminate
      certificateRefs:
      - kind: Secret
        name: "{{ tt_tls_secret }}"
{% endif %}