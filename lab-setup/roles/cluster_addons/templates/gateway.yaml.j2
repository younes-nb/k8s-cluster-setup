{#
  Gateway API + Envoy Gateway + MetalLB.
  Replaces the classic istio-ingressgateway and the retired in-namespace
  Gateway API proxy. No NodePorts: MetalLB advertises gateway_private_ip.
#}
apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: benchmark
  namespace: {{ metallb_namespace }}
spec:
  addresses: ["{{ gateway_private_ip }}/32"]
  autoAssign: false
---
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata:
  name: benchmark
  namespace: {{ metallb_namespace }}
spec:
  ipAddressPools: [benchmark]
---
apiVersion: gateway.envoyproxy.io/v1alpha1
kind: EnvoyProxy
metadata:
  name: benchmark
  namespace: {{ tt_ns }}
spec:
  provider:
    type: Kubernetes
    kubernetes:
      envoyDeployment:
        replicas: {{ gateway_replicas }}
        container:
          resources:
            requests: {cpu: "500m", memory: "256Mi"}
            limits: {memory: "1Gi"}
      envoyService:
        type: LoadBalancer
        allocateLoadBalancerNodePorts: false
        externalTrafficPolicy: Cluster
        annotations:
          metallb.io/address-pool: benchmark
---
apiVersion: gateway.networking.k8s.io/v1
kind: GatewayClass
metadata:
  name: {{ gateway_class | default('lab-envoy') }}
spec:
  controllerName: gateway.envoyproxy.io/gatewayclass-controller
---
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: train-ticket
  namespace: {{ tt_ns }}
spec:
  gatewayClassName: {{ gateway_class | default('lab-envoy') }}
  addresses:
    - type: IPAddress
      value: "{{ gateway_private_ip }}"
  infrastructure:
    parametersRef:
      group: gateway.envoyproxy.io
      kind: EnvoyProxy
      name: benchmark
  listeners:
    - name: http
      port: 80
      protocol: HTTP
      allowedRoutes:
        namespaces:
          from: Same
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: train-ticket
  namespace: {{ tt_ns }}
spec:
  parentRefs:
    - name: train-ticket
      sectionName: http
  rules:
    - matches:
        - path: {type: PathPrefix, value: /}
      backendRefs:
        - name: ts-ui-dashboard
          port: 8080
---
# Envoy's own metrics, scraped by Alloy.
apiVersion: monitoring.coreos.com/v1
kind: PodMonitor
metadata:
  name: envoy-gateway-proxy
  namespace: {{ monitoring_ns }}
spec:
  namespaceSelector: {any: true}
  selector:
    matchLabels:
      app.kubernetes.io/name: envoy
      app.kubernetes.io/component: proxy
  podMetricsEndpoints:
    - port: metrics
      path: /stats/prometheus
      interval: 5s
      scrapeTimeout: 4s