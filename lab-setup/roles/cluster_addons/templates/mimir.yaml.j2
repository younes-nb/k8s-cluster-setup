---
apiVersion: v1
kind: ConfigMap
metadata:
  name: mimir-conf
  namespace: {{ monitoring_ns }}
data:
  mimir.yaml: |
    multitenancy_enabled: false
    server:
      http_listen_port: 8080
      grpc_listen_port: 9095
    distributor: {}
    ingester_client: {}
    ingester:
      ring:
        kvstore:
          store: inmemory
        replication_factor: 1
    blocks_storage:
      backend: filesystem
      bucket_store:
        sync_dir: /mimir/sync
      filesystem:
        dir: /mimir/blocks
      tsdb:
        dir: /mimir/tsdb
    compactor:
      data_dir: /mimir/compactor
      sharding_ring:
        kvstore:
          store: inmemory
    store_gateway:
      sharding_ring:
        replication_factor: 1
    limits:
      compactor_blocks_retention_period: {{ mimir_retention }}
      max_label_names_per_series: 50
      ingestion_rate: {{ mimir_ingest_rate }}
      ingestion_burst_size: {{ mimir_ingest_burst }}
      max_global_series_per_user: {{ mimir_max_series }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mimir
  namespace: {{ monitoring_ns }}
  labels:
    app: mimir
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: mimir
  template:
    metadata:
      labels:
        app: mimir
    spec:
      # Monitoring belongs on the control-plane nodes, never on a worker:
      # a worker is also a benchmark target. `podAntiAffinity` keeps Loki and
      # Mimir on different masters so neither starves the other. No
      # priorityClassName is set on purpose: the default (0) is far below etcd's
      # system-node-critical, so monitoring is evicted before the control plane.
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              - matchExpressions:
                  - key: node-role.kubernetes.io/control-plane
                    operator: Exists
        podAntiAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            - labelSelector:
                matchExpressions:
                  - key: app
                    operator: In
                    values: [loki, mimir]
              topologyKey: kubernetes.io/hostname
      priorityClassName: monitoring-critical
      tolerations:
        - key: node-role.kubernetes.io/control-plane
          operator: Exists
          effect: NoSchedule
      containers:
      - name: mimir
        image: {{ mimir_image }}
        args: ["-config.file=/etc/mimir/mimir.yaml", "-target=all"]
        env:
        - name: GOMEMLIMIT
          # Go soft heap limit ~90% of the hard limit so GC works instead of OOM
          value: "4GiB"
        ports:
        - {containerPort: 8080, name: http}
        - {containerPort: 9095, name: grpc}
        volumeMounts:
        - {name: conf, mountPath: /etc/mimir}
        - {name: data, mountPath: /mimir}
        readinessProbe:
          httpGet: {path: /ready, port: 8080}
          initialDelaySeconds: 60
          periodSeconds: 15
        resources:
          requests: {cpu: "500m", memory: "2Gi"}
          limits: {cpu: "2", memory: "4Gi"}
      volumes:
      - name: conf
        configMap:
          name: mimir-conf
      - name: data
        persistentVolumeClaim:
          claimName: mimir-data
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: mimir-data
  namespace: {{ monitoring_ns }}
spec:
  accessModes: ["ReadWriteOnce"]
  storageClassName: {{ monitoring_storage_class }}
  resources:
    requests:
      storage: {{ mimir_pvc_size }}
---
apiVersion: v1
kind: Service
metadata:
  name: mimir
  namespace: {{ monitoring_ns }}
spec:
  selector:
    app: mimir
  ports:
  - {name: http, port: 8080, targetPort: 8080}

