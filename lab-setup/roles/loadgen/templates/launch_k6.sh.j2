#!/bin/bash

set -euo pipefail

cd /opt/loadgen

MCR_CSV="${MCR_CSV:-/opt/loadgen/mcr.csv}"
MAX_REQUESTS="${MAX_REQUESTS:-5000}"
USER_POOL="${USER_POOL:-500}"
SEED_FILE="${SEED_FILE:-/opt/loadgen/seeds/tt_users.json}"
START_MIN="${START_MIN:-497}"
TEST_MIN="${TEST_MIN:-0}"
TRACE_COMPRESS="${TRACE_COMPRESS:-1}"
OPEN_LOOP="${OPEN_LOOP:-1}"
PRE_ALLOCATED_VUS="${PRE_ALLOCATED_VUS:-100}"
FLAT_RPS="${FLAT_RPS:-0}"
K6_BIN="${K6_BIN:-/usr/local/bin/k6}"

TARGET_URL="${TARGET_URL:-http://{{ cloudlab_private_ips.master1 }}:30080}"

case "$MCR_CSV" in /*) ;; *) MCR_CSV="/opt/loadgen/$MCR_CSV";; esac
case "$SEED_FILE" in /*) ;; *) SEED_FILE="/opt/loadgen/$SEED_FILE";; esac

echo "Starting k6 train-ticket (private network) targeting $TARGET_URL"
echo "  MCR_CSV=$MCR_CSV START_MIN=$START_MIN TEST_MIN=$TEST_MIN"
echo "  MAX_REQUESTS=$MAX_REQUESTS USER_POOL=$USER_POOL SEED_FILE=$SEED_FILE"
echo "  TRACE_COMPRESS=$TRACE_COMPRESS OPEN_LOOP=$OPEN_LOOP"

if [ ! -f "$MCR_CSV" ]; then
  echo "WARN: MCR_CSV not found at $MCR_CSV — run must copy it first"
  echo "      scp <head>:/proj/k8sautoscaledl-PG0/nasa/jul13-14/http_mcr_NASA_jul95.csv $MCR_CSV"
fi

HOST="$TARGET_URL" MCR_CSV="$MCR_CSV" MAX_REQUESTS="$MAX_REQUESTS" \
USER_POOL="$USER_POOL" SEED_FILE="$SEED_FILE" START_MIN="$START_MIN" \
TEST_MIN="$TEST_MIN" TRACE_COMPRESS="$TRACE_COMPRESS" OPEN_LOOP="$OPEN_LOOP" \
PRE_ALLOCATED_VUS="$PRE_ALLOCATED_VUS" FLAT_RPS="$FLAT_RPS" "$K6_BIN" run \
  $([ -n "${K6_PROMETHEUS_RW_SERVER_URL:-}" ] && echo "-o experimental-prometheus-rw" || true) \
  /opt/loadgen/trainticket.js