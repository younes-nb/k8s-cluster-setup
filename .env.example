# CloudLab experiment public hostnames (resolve to public IPs)
CLOUDLAB_DOMAIN=
LOADGEN=
MASTER1=
MASTER2=
MASTER3=
WORKER1=
WORKER2=
WORKER3=

# Private network IPs (experiment link-1 LAN, 10.10.1.0/24) — optional, used by loadgen
# If set, loadgen targets these; if unset, loadgen will SSH-resolve at runtime.
LOADGEN_PRIVATE_IP=10.10.1.1
MASTER1_PRIVATE_IP=10.10.1.2
MASTER2_PRIVATE_IP=10.10.1.3
MASTER3_PRIVATE_IP=10.10.1.4
WORKER1_PRIVATE_IP=10.10.1.5
WORKER2_PRIVATE_IP=10.10.1.6
WORKER3_PRIVATE_IP=10.10.1.7